# Copier en .env (jamais commité).
# Clés acceptées par l'API, séparées par des virgules. Générer : python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=changez-moi
# Clé utilisée par l'application Streamlit (doit figurer dans API_KEYS)
APP_API_KEY=changez-moi
LOW_CONFIDENCE=0.5
GRAFANA_PASSWORD=changez-moi
# Optionnel : benchmark avec l'API Mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Optionnel : suivi d'expériences
MLFLOW_TRACKING_URI=
